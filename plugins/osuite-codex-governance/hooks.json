{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/osuite_pretool.mjs\"",
            "timeout": 60,
            "statusMessage": "OSuite policy preflight"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/osuite_posttool.mjs\"",
            "timeout": 60,
            "statusMessage": "OSuite evidence capture"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/osuite_session.mjs\"",
            "timeout": 60,
            "statusMessage": "OSuite runtime posture"
          }
        ]
      }
    ]
  }
}
